// Schema tự thiết kế từ mọi bảng/field được nhắc cụ thể trong tai-lieu-cong-nghe-backend.md và
// tài liệu bussiness.md — KHÔNG phải bản sao của "31 bảng đã thiết kế" gốc (tài liệu đó không có
// sẵn ở đây). Field nào không được tài liệu nêu tên rõ thì tự bổ sung hợp lý, đánh dấu bằng comment.
//
// Cột geography (postedLocation, location) khai báo qua Unsupported() vì Prisma Client không tự
// đọc/ghi kiểu geography — truy vấn bán kính dùng $queryRaw (ST_DWithin/ST_Distance), xem
// src/modules/posts/posts.service.ts. Trước khi chạy `prisma migrate dev` lần đầu, PHẢI bật
// extension PostGIS trên Supabase (Dashboard → Database → Extensions, hoặc
// `create extension if not exists postgis;`) — nếu không, cột kiểu geography sẽ lỗi khi tạo bảng.
// Sau migrate, chạy prisma/manual-sql/gist-indexes.sql một lần để thêm index GiST (bắt buộc theo
// tai-lieu-cong-nghe-backend.md §11 — Prisma Migrate không tự sinh được index GiST).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===================== NGƯỜI DÙNG & PHIÊN =====================

model User {
  // Tự sinh UUID — KHÔNG còn bằng auth.users.id của Supabase nữa. OTP đăng nhập/đăng ký do NestJS
  // tự quản lý (auth/otp.service.ts, không dùng Supabase Auth cho user thường — quyết định đổi từ
  // tai-lieu-cong-nghe-backend.md §4.1, xem ghi chú tại đầu module auth/).
  id                  String        @id @default(uuid()) @db.Uuid
  phoneNumber         String        @unique @map("phone_number")
  alias               String        @unique // bí danh tự sinh, cố định vĩnh viễn (bussiness §4.3)
  // Bắt buộc điền lúc onboarding (bổ sung ngoài 117 mục gốc, quyết định 2026-08-20) — cột vẫn
  // nullable vì user CŨ (tạo trước khi có yêu cầu này) chưa có dữ liệu, tính "đã điền đủ hồ sơ" ở
  // FE bằng cách kiểm tra cả 4 trường (realName/avatarUrl/dateOfBirth/gender) đều khác null, không
  // lưu cờ onboardingCompleted riêng để tránh lệch dữ liệu (cùng triết lý "tính runtime" như
  // accountStatus='restricted' tự hết hiệu lực ở trên).
  realName            String?       @map("real_name")
  avatarUrl           String?       @map("avatar_url") // ảnh đại diện (tai-lieu-chuc-nang.md #37) — URL Supabase Storage, bucket "avatars"
  dateOfBirth         DateTime?     @map("date_of_birth") @db.Date
  gender              Gender?
  trustScoreE1        Float         @default(0) @map("trust_score_e1") // Lớp 1, chỉ tăng — điểm hiển thị = E1 trừ E2_hiệu_lực tính runtime
  // Trạng thái tài khoản (tai-lieu-chuc-nang.md #74) — thay cho isBanned boolean cũ (chỉ 1 mức,
  // không có lý do). "restricted" tự hết hiệu lực khi qua restrictedUntil, tính runtime lúc đọc,
  // không cần cron riêng (khác hẳn deletionRequestedAt bên dưới — cái đó cần cron thật vì phải hard
  // delete, không thể "tự hết hiệu lực" bằng cách đọc).
  accountStatus       AccountStatus @default(active) @map("account_status")
  statusReason        String?       @map("status_reason")
  restrictedUntil     DateTime?     @map("restricted_until")
  // Opt-in kiếm tiền (bussiness §5.1a) — 2 công tắc ĐỘC LẬP, tắt mặc định cho mọi user. E1/E2 vẫn
  // tính cho mọi user bất kể 2 cờ này (đây chỉ quyết định có được QUY ĐỔI thành tiền thật hay không).
  earnViaPostsEnabled Boolean       @default(false) @map("earn_via_posts_enabled")
  affiliateEnabled    Boolean       @default(false) @map("affiliate_enabled")
  // Mốc bật GẦN NHẤT của 1 trong 2 công tắc trên — KHÔNG hồi tố (chỉ tính thưởng từ mốc này trở đi).
  // Tắt rồi bật lại = mốc mới, không khôi phục mốc cũ (bussiness §5.1a).
  earnEnabledAt       DateTime?     @map("earn_enabled_at")
  // Yêu cầu xóa tài khoản (tai-lieu-chuc-nang.md #69, #73 — đã hợp nhất 1 luồng, mô hình mềm 30
  // ngày theo quyết định mới nhất). Set lúc bấm "xóa tài khoản", null lại nếu đăng nhập lại trong
  // 30 ngày (khôi phục). AccountDeletionCronService hard-delete khi quá hạn.
  deletionRequestedAt DateTime?     @map("deletion_requested_at")
  // Cộng tác viên nội bộ (đăng bài mồi/tương tác thủ công, ngoài phạm vi tài liệu chức năng gốc,
  // xem CollaboratorsService) — tài khoản THẬT, tự đăng ký/đăng nhập bằng SĐT thật như user thường,
  // admin chỉ ĐÁNH DẤU sau khi họ đã có tài khoản (không đụng luồng OTP/auth). Cờ THUẦN NỘI BỘ,
  // không hiện với ai — chỉ dùng để: (1) loại khỏi điều kiện rút thưởng thật, (2) loại khỏi bảng xếp
  // hạng thưởng, (3) loại khỏi số liệu tăng trưởng thật (G1, user mới trong ngày).
  isCollaborator      Boolean       @default(false) @map("is_collaborator")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  collaboratorKpiTarget  CollaboratorKpiTarget?
  appSessions            AppSession[]
  refreshTokens          RefreshToken[]
  fixedAreas             FixedArea[]
  posts                  Post[]
  comments               Comment[]
  votesGiven             Vote[]                     @relation("VoteVoter")
  trustScoreHistory      TrustScoreHistory[]
  penaltyAppeals         PenaltyAppeal[]
  reportsFiled           Report[]                   @relation("ReportReporter")
  merchantProfile        MerchantProfile?
  bankAccounts           UserBankAccount[]
  payoutRequests         PayoutRequest[]
  rewardLedger           RewardLedger[]
  rewardWallet           RewardWallet?
  monthlyTierSnapshots   MonthlyTierSnapshot[]
  leaderboardSnapshots   LeaderboardSnapshot[]
  pushTokens             PushToken[]
  notifSetting           NotificationDigestSetting?
  emergencyConfirmations EmergencyConfirmation[]
  dataDeletionRequests   DataDeletionRequest[]
  ignoredUsers           IgnoredUser[]              @relation("IgnoreOwner")
  ignoredByUsers         IgnoredUser[]              @relation("IgnoreTarget")
  postViews              PostView[]
  notifications          Notification[]
  termsAcceptances       TermsAcceptance[]

  @@map("users")
}

enum AccountStatus {
  active
  banned
  restricted
}

enum Gender {
  male
  female
  other
}

// Xác nhận đồng ý Điều khoản, có lưu vết (tai-lieu-chuc-nang.md #67, bắt buộc theo NĐ 13/2023) —
// lưu MỖI lần đồng ý (không ghi đè), giữ lịch sử đầy đủ nếu điều khoản đổi version sau này và cần
// user đồng ý lại.
model TermsAcceptance {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  version    String
  acceptedAt DateTime @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, acceptedAt])
  @@map("terms_acceptances")
}

// Tính năng "Không quan tâm" (tai-lieu-chuc-nang.md #32) — ẩn thầm lặng 1 người, chỉ ảnh hưởng feed
// của chính người bấm ẩn, không thông báo/ảnh hưởng gì tới người bị ẩn (khác hẳn block 2 chiều).
model IgnoredUser {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  ignoredUserId String   @map("ignored_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  user        User @relation("IgnoreOwner", fields: [userId], references: [id], onDelete: Cascade)
  ignoredUser User @relation("IgnoreTarget", fields: [ignoredUserId], references: [id], onDelete: Cascade)

  @@unique([userId, ignoredUserId])
  @@map("ignored_users")
}

model AppSession {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  openedAt DateTime  @default(now()) @map("opened_at") // nguồn duy nhất cho hệ số hoạt động (bussiness §4.2c) và G1
  // Lúc app chuyển nền/đóng (AppState 'background'|'inactive', xem src/lib/appSessionTracker.ts
  // phía mobile) — null nếu app bị crash/force-kill trước khi kịp gửi (chấp nhận thiếu sót nhỏ,
  // KHÔNG dùng heartbeat liên tục để đỡ tốn pin). Nguồn cho "thời gian dùng thật" (bổ sung ngoài
  // 117 mục gốc, xem CollaboratorsService/UserActivityService) — trước đây KHÔNG có cột này, cũng
  // KHÔNG có bất kỳ route nào GHI vào bảng này (chỉ đọc) — mọi nơi dựa vào AppSession trước đây
  // (activityFactor, G1, qualifyIfActive) thực chất luôn nhận dữ liệu rỗng, đã vá cùng lúc.
  closedAt DateTime? @map("closed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, openedAt])
  @@map("app_sessions")
}

// Vòng đời OTP đăng nhập/đăng ký (auth/otp.service.ts) — 1 bản ghi/lần gửi, không cập nhật đè lên
// bản ghi cũ (bản cũ bị đánh dấu consumedAt khi có OTP mới cùng SĐT, xem OtpService.invalidatePrevious).
model OtpVerification {
  id          String    @id @default(uuid()) @db.Uuid
  phoneNumber String    @map("phone_number") // E.164 đã chuẩn hoá, vd +84912345678
  otpHash     String    @map("otp_hash") // HMAC-SHA256(otp, OTP_HASH_SECRET) — không lưu OTP dạng thô
  attempts    Int       @default(0) // tăng atomic mỗi lần verify sai, khoá khi vượt ngưỡng (OtpService)
  consumedAt  DateTime? @map("consumed_at") // set khi verify đúng HOẶC bị 1 OTP mới hơn của cùng SĐT vô hiệu hoá
  expiresAt   DateTime  @map("expires_at") // now + 5 phút lúc tạo
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phoneNumber, createdAt]) // phục vụ đếm rate-limit theo SĐT + tra bản ghi mới nhất
  @@map("otp_verifications")
}

// Refresh token xoay vòng (rotation) — mỗi lần dùng để lấy access token mới thì token cũ bị revoke
// và cấp token mới, phát hiện được nếu 1 refresh token bị đánh cắp và dùng lại (TokenService).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") // SHA-256(token) — không lưu token thô
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

enum AreaLabel {
  home
  work
}

model FixedArea {
  id          String                                 @id @default(uuid()) @db.Uuid
  userId      String                                 @map("user_id") @db.Uuid
  label       AreaLabel
  addressText String                                 @map("address_text")
  lat         Float
  lng         Float
  location    Unsupported("geography(Point, 4326)")?
  radiusKm    Float                                  @default(2) @map("radius_km")
  createdAt   DateTime                               @default(now()) @map("created_at")
  updatedAt   DateTime                               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label]) // đúng 1 "Nhà" + 1 "Chỗ làm" mỗi user (bussiness §2.1)
  @@map("fixed_areas")
}

// ===================== BÀI ĐĂNG & TƯƠNG TÁC =====================

enum PostType {
  life
  merchant
  emergency
}

enum DisplayMode {
  alias
  real_name
}

enum PostStatus {
  active
  removed
  expired
}

enum PostFontSize {
  small
  medium
  large
}

model Post {
  id                  String                                 @id @default(uuid()) @db.Uuid
  authorId            String                                 @map("author_id") @db.Uuid
  postType            PostType                               @map("post_type")
  content             String
  lat                 Float
  lng                 Float
  postedLocation      Unsupported("geography(Point, 4326)")? @map("posted_location") // luôn là GPS thật lúc đăng, không phải fixed area
  displayMode         DisplayMode                            @default(alias) @map("display_mode")
  isLibraryPhoto      Boolean                                @default(false) @map("is_library_photo") // chỉ true hợp lệ cho merchant đã xác minh
  status              PostStatus                             @default(active)
  // Style toàn bộ nội dung (tai-lieu-chuc-nang.md #22, giống Instagram/Threads Story text tool — 1
  // style áp dụng cho CẢ đoạn text, không phải rich text nhiều style/đoạn). null = giao diện mặc
  // định hiện tại (không đổi gì). textColor/backgroundColor là mã hex, validate ở CreatePostDto/
  // UpdatePostDto — chỉ nhận đúng format hex để tránh chèn giá trị lạ vào style CSS khi admin panel
  // (web) render lại.
  textColor           String?                                @map("text_color")
  backgroundColor     String?                                @map("background_color")
  fontSize            PostFontSize?                          @map("font_size")
  voteCount           Int                                    @default(0) @map("vote_count") // cache, cộng dồn từ Vote để đọc nhanh
  commentCount        Int                                    @default(0) @map("comment_count")
  expiresAt           DateTime?                              @map("expires_at") // null = khẩn cấp (không tự hết hạn tới khi giải quyết)
  emergencyVerifiedAt DateTime?                              @map("emergency_verified_at") // đạt đủ ngưỡng xác nhận độc lập (bussiness §3, §7D.1 #6) — null = chưa đủ, chỉ hiện hẹp
  // Admin đánh dấu tình huống khẩn cấp đã qua (VD "mất điện đã có lại") — KHÁC hẳn
  // emergencyVerifiedAt (xác nhận đây là tin THẬT). 1 bài có thể verified nhưng chưa resolved
  // (đang xử lý), hoặc admin resolve thủ công dù chưa đủ ngưỡng verified (tai-lieu-chuc-nang.md #90).
  emergencyResolvedAt DateTime?                              @map("emergency_resolved_at")
  // Bài mồi admin tự đăng cho khu mới thí điểm chưa đủ user (tai-lieu-chuc-nang.md #100) — cờ NỘI
  // BỘ để tách khỏi số liệu bài đăng thật, KHÔNG hiện với user thường (tác giả vẫn hiện bí danh
  // bình thường trong feed, không lộ đây là bài mồi).
  isSeeded            Boolean                                @default(false) @map("is_seeded")
  createdAt           DateTime                               @default(now()) @map("created_at")
  updatedAt           DateTime                               @updatedAt @map("updated_at")

  author                 User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images                 PostImage[]
  comments               Comment[]
  votes                  Vote[]                  @relation("VoteOnPost")
  emergencyConfirmations EmergencyConfirmation[]
  reports                Report[]
  views                  PostView[]

  @@index([status, postType, expiresAt])
  @@map("posts")
}

// Thống kê "ai đã xem bài" (tai-lieu-chuc-nang.md #44) — CHỈ hiện TỔNG SỐ, không hiện danh sách
// từng người xem (đã chốt với user — đánh đổi quyền riêng tư người xem). unique [postId, viewerId]
// nên xem lại nhiều lần vẫn tính 1, không phóng đại số liệu.
model PostView {
  id       String   @id @default(uuid()) @db.Uuid
  postId   String   @map("post_id") @db.Uuid
  viewerId String   @map("viewer_id") @db.Uuid
  viewedAt DateTime @default(now()) @map("viewed_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewer User @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([postId, viewerId])
  @@map("post_views")
}

model PostImage {
  id             String    @id @default(uuid()) @db.Uuid
  postId         String    @map("post_id") @db.Uuid
  url            String
  exifCapturedAt DateTime? @map("exif_captured_at") // đối chiếu chống khai gian "chụp trực tiếp" (bussiness §4.2 Tầng 1)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_images")
}

enum CommentVisibility {
  public
  private
}

model Comment {
  id              String            @id @default(uuid()) @db.Uuid
  postId          String            @map("post_id") @db.Uuid
  authorId        String            @map("author_id") @db.Uuid
  content         String
  visibility      CommentVisibility @default(public)
  isPinned        Boolean           @default(false) @map("is_pinned") // chủ bài tự ghim (bussiness §4.1.1)
  // ẩn bởi chủ bài (setHiddenByOwner) HOẶC tự xoá bởi chính tác giả (deleteOwn) — cùng field vì hiệu
  // ứng với người xem giống hệt nhau (không còn ai thấy, không có màn khôi phục). Không còn liên quan
  // điểm uy tín thấp — logic tự động ẩn theo trust score đã bỏ (bussiness §4.1 quy tắc 3, đã bỏ).
  isHidden        Boolean           @default(false) @map("is_hidden")
  // Reply lồng nhau CHỈ 1 cấp (quyết định 2026-08-20) — trả lời 1 reply tự "phẳng hoá" về đúng bình
  // luận GỐC lúc tạo (CommentsService.resolveParentCommentId), null = bình luận gốc. Ẩn 1 bình luận
  // gốc tự động ẩn theo mọi reply trực tiếp của nó (CommentsService.cascadeHideReplies).
  parentCommentId String?           @map("parent_comment_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")

  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")
  votes         Vote[]    @relation("VoteOnComment")
  reports       Report[]

  @@index([postId, createdAt])
  @@index([parentCommentId])
  @@map("comments")
}

enum VoteTargetType {
  post
  comment
}

model Vote {
  id            String         @id @default(uuid()) @db.Uuid
  targetType    VoteTargetType @map("target_type")
  postId        String?        @map("post_id") @db.Uuid
  commentId     String?        @map("comment_id") @db.Uuid
  voterId       String         @map("voter_id") @db.Uuid
  weightApplied Float          @map("weight_applied") // snapshot tại thời điểm vote — KHÔNG tính lại (bussiness §4.2d)
  createdAt     DateTime       @default(now()) @map("created_at")

  voter   User     @relation("VoteVoter", fields: [voterId], references: [id], onDelete: Cascade)
  post    Post?    @relation("VoteOnPost", fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation("VoteOnComment", fields: [commentId], references: [id], onDelete: Cascade)

  // Lưu ý: Postgres coi NULL khác NULL nên constraint này không chặn tuyệt đối vote trùng khi
  // postId/commentId null lẫn nhau — votes.service.ts phải tự kiểm tra đã vote chưa trước khi ghi.
  @@unique([voterId, postId, commentId])
  @@map("votes")
}

model EmergencyConfirmation {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  confirmerId String   @map("confirmer_id") @db.Uuid
  // GPS lúc xác nhận (tai-lieu-chuc-nang.md #7e) — dùng để kiểm tra "trong bán kính nhỏ" quanh bài,
  // đúng tinh thần "xác nhận độc lập tại chỗ" thay vì xác nhận từ xa (bussiness §3). Nullable vì cột
  // mới thêm sau — mọi xác nhận MỚI từ nay đều bắt buộc gửi qua ConfirmEmergencyDto.
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now()) @map("created_at")

  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  confirmer User @relation(fields: [confirmerId], references: [id], onDelete: Cascade)

  @@unique([postId, confirmerId])
  @@map("emergency_confirmations")
}

// ===================== UY TÍN & KIỂM DUYỆT =====================

enum TrustScoreSourceType {
  vote
  violation_confirmed
  appeal_reversal
}

// Mức độ vi phạm — cùng danh sách với ViolationSeverity (votes/trust-score.service.ts), tách enum
// Prisma riêng vì union type TS không map thẳng được vào cột DB.
enum ViolationSeverity {
  light
  medium
  severe
}

model TrustScoreHistory {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @map("user_id") @db.Uuid
  delta              Float
  sourceType         TrustScoreSourceType @map("source_type")
  // Chỉ set khi sourceType = violation_confirmed — dùng tính "Hệ số không vi phạm" trong công thức
  // xếp hạng thưởng (bussiness §5.1b): tổng_trọng_lượng = Nhẹ×1 + Trung_bình×2 + Nghiêm_trọng×5.
  severity           ViolationSeverity?
  referenceId        String?              @map("reference_id") @db.Uuid
  confirmedByAdminId String?              @map("confirmed_by_admin_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  confirmedByAdmin AdminUser?      @relation(fields: [confirmedByAdminId], references: [id])
  penaltyAppeals   PenaltyAppeal[]

  @@index([userId, createdAt])
  @@map("trust_score_history")
}

enum AppealStatus {
  pending
  approved
  rejected
}

model PenaltyAppeal {
  id                  String       @id @default(uuid()) @db.Uuid
  trustScoreHistoryId String       @map("trust_score_history_id") @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  explanation         String
  status              AppealStatus @default(pending)
  reviewedByAdminId   String?      @map("reviewed_by_admin_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at")

  trustScoreHistory TrustScoreHistory @relation(fields: [trustScoreHistoryId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedByAdmin   AdminUser?        @relation(fields: [reviewedByAdminId], references: [id])

  @@map("penalty_appeals")
}

enum ReportTargetType {
  post
  comment
  merchant_suspicious
}

enum ReportStatus {
  pending
  reviewed
  actioned
  dismissed
}

model Report {
  id                String           @id @default(uuid()) @db.Uuid
  targetType        ReportTargetType @map("target_type")
  postId            String?          @map("post_id") @db.Uuid
  commentId         String?          @map("comment_id") @db.Uuid
  merchantId        String?          @map("merchant_id") @db.Uuid
  reporterId        String?          @map("reporter_id") @db.Uuid // ẩn danh với người bị báo cáo, backend vẫn biết
  reason            String
  description       String?
  status            ReportStatus     @default(pending)
  reviewedByAdminId String?          @map("reviewed_by_admin_id") @db.Uuid
  // Mốc LẦN ĐẦU admin xử lý (ReportsService.updateStatus không ghi đè nếu đã có) — dùng tính "thời
  // gian xử lý report trung bình" (G7, tai-lieu-chuc-nang.md #109). Trước đây không có cột nào ghi
  // lại thời điểm này, chỉ có createdAt + reviewedByAdminId (biết AI xử lý, không biết XỬ LÝ LÚC NÀO).
  reviewedAt        DateTime?        @map("reviewed_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  post            Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment         Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  merchant        MerchantProfile? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  reporter        User?            @relation("ReportReporter", fields: [reporterId], references: [id])
  reviewedByAdmin AdminUser?       @relation(fields: [reviewedByAdminId], references: [id])

  @@index([status, targetType])
  @@map("reports")
}

model CollusionFlag {
  id              String   @id @default(uuid()) @db.Uuid
  involvedUserIds String[] @map("involved_user_ids") // graph-based detection (bussiness §4.2a quy tắc 4) — không ràng buộc FK, chỉ tham chiếu
  evidence        Json
  status          String   @default("pending") // pending | confirmed | dismissed
  detectedAt      DateTime @default(now()) @map("detected_at")

  @@map("collusion_flags")
}

model CommentAttackIncident {
  id               String    @id @default(uuid()) @db.Uuid
  postId           String    @map("post_id") @db.Uuid
  triggeredAt      DateTime  @default(now()) @map("triggered_at")
  lockedUntil      DateTime  @map("locked_until")
  authorNotifiedAt DateTime? @map("author_notified_at")

  @@map("comment_attack_incidents")
}

// ===================== MERCHANT =====================

enum PhoneVisibility {
  always
  business_hours
  hidden
}

model MerchantProfile {
  id                  String                                 @id @default(uuid()) @db.Uuid
  userId              String                                 @unique @map("user_id") @db.Uuid
  businessName        String                                 @map("business_name")
  addressText         String                                 @map("address_text")
  category            String?
  lat                 Float
  lng                 Float
  location            Unsupported("geography(Point, 4326)")?
  isVerified          Boolean                                @default(false) @map("is_verified") // điều kiện để dùng ảnh thư viện (bussiness §2.1)
  verifiedAt          DateTime?                              @map("verified_at")
  phoneVisibility     PhoneVisibility                        @default(hidden) @map("phone_visibility")
  zaloEnabled         Boolean                                @default(false) @map("zalo_enabled")
  freeMonthsRemaining Int                                    @default(0) @map("free_months_remaining")
  createdAt           DateTime                               @default(now()) @map("created_at")
  updatedAt           DateTime                               @updatedAt @map("updated_at")

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuPhotos          MerchantMenuPhoto[]
  reports             Report[]
  subscriptions       MerchantSubscription[]
  paymentTransactions PaymentTransaction[]
  businessHours       MerchantBusinessHour[]

  @@map("merchant_profiles")
}

// Khung giờ hiện SĐT/Zalo theo TỪNG NGÀY trong tuần (tai-lieu-chuc-nang.md #43) — thay cho 2 cột
// phẳng businessHoursStart/End cũ (1 khung áp dụng mọi ngày). Ngày nào KHÔNG có dòng tương ứng ở đây
// = merchant chưa cấu hình ngày đó, coi như ẨN số ngày đó (an toàn hơn suy đoán 1 khung mặc định).
model MerchantBusinessHour {
  id         String @id @default(uuid()) @db.Uuid
  merchantId String @map("merchant_id") @db.Uuid
  dayOfWeek  Int    @map("day_of_week") // 0=Chủ nhật .. 6=Thứ Bảy, khớp Date.getDay() giờ Việt Nam
  startTime  String @map("start_time") // "HH:mm"
  endTime    String @map("end_time") // "HH:mm"

  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, dayOfWeek])
  @@map("merchant_business_hours")
}

model MerchantMenuPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  url        String
  caption    String?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_menu_photos")
}

// ===================== ADMIN =====================

model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash") // xác thực riêng biệt, không dùng chung OTP Supabase (bussiness §9.1 A1)
  name         String
  isOwner      Boolean  @default(false) @map("is_owner")
  createdAt    DateTime @default(now()) @map("created_at")

  permissions          AdminUserPermission[]
  actionLogs           AdminActionLog[]
  sensitiveAccessLogs  SensitiveDataAccessLog[]
  reviewedTrustHistory TrustScoreHistory[]
  reviewedAppeals      PenaltyAppeal[]
  reviewedReports      Report[]
  publishedLegalDocs   LegalDocument[]

  @@map("admin_users")
}

model Permission {
  id            String @id @default(uuid()) @db.Uuid
  permissionKey String @unique @map("permission_key")
  label         String
  groupName     String @map("group_name")

  adminUsers AdminUserPermission[]

  @@map("permissions")
}

model AdminUserPermission {
  adminUserId  String @map("admin_user_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  adminUser  AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([adminUserId, permissionId])
  @@map("admin_user_permissions")
}

model AdminActionLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("admin_action_logs")
}

model SensitiveDataAccessLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  dataType    String   @map("data_type") // vd "user_location" | "private_comment" | "bank_account"
  targetId    String   @map("target_id")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("sensitive_data_access_logs")
}

// ===================== THANH TOÁN (bussiness §11.3) =====================

model MerchantSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  planKey    String   @map("plan_key")
  startedAt  DateTime @default(now()) @map("started_at")
  expiresAt  DateTime @map("expires_at")
  status     String   @default("active")

  merchant            MerchantProfile      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentTransactions PaymentTransaction[]

  @@map("merchant_subscriptions")
}

enum PaymentProvider {
  vnpay
  momo
  zalopay
}

model PaymentTransaction {
  id                    String          @id @default(uuid()) @db.Uuid
  merchantId            String          @map("merchant_id") @db.Uuid
  subscriptionId        String?         @map("subscription_id") @db.Uuid
  amount                Int // VND
  provider              PaymentProvider
  providerTransactionId String?         @map("provider_transaction_id")
  status                String          @default("pending")
  createdAt             DateTime        @default(now()) @map("created_at")

  merchant     MerchantProfile       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  subscription MerchantSubscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payment_transactions")
}

model UserBankAccount {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  bankCode               String    @map("bank_code")
  accountNumberEncrypted String    @map("account_number_encrypted") // mã hoá ở tầng service, không lưu plaintext
  // Hash CÓ THỂ SO SÁNH (HMAC, khác accountNumberEncrypted dùng IV ngẫu nhiên) để dò trùng số tài
  // khoản giữa các user — rào cản chống gian lận CHÍNH (bussiness §11: "1 số tài khoản ngân hàng chỉ
  // được gắn với đúng 1 tài khoản Phố Mình"). Nullable — dòng cũ trước khi có field này chưa có hash
  // (không backfill được bằng SQL thuần, cần giải mã ở tầng ứng dụng), chỉ áp dụng cho liên kết MỚI.
  accountNumberHash      String?   @map("account_number_hash")
  accountHolderName      String    @map("account_holder_name")
  verifiedAt             DateTime? @map("verified_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutRequests PayoutRequest[]

  @@index([accountNumberHash])
  @@map("user_bank_accounts")
}

enum PayoutSource {
  leaderboard
  referral
}

enum PayoutStatus {
  pending
  processing
  success
  failed
}

model PayoutRequest {
  id                    String       @id @default(uuid()) @db.Uuid
  userId                String       @map("user_id") @db.Uuid
  bankAccountId         String       @map("bank_account_id") @db.Uuid
  amount                Int
  source                PayoutSource
  status                PayoutStatus @default(pending)
  providerTransactionId String?      @map("provider_transaction_id")
  createdAt             DateTime     @default(now()) @map("created_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount UserBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@map("payout_requests")
}

// ===================== THƯỞNG & GIỚI THIỆU (bussiness §5.1) =====================

enum RewardLedgerType {
  leaderboard
  referral
  // Giữ lại giá trị này để không phá migration nếu đã có dòng cũ dùng nó — bussiness §5.1e đã CHỐT
  // bỏ hẳn mô hình voucher, chỉ còn tiền mặt qua Momo/VNPay, KHÔNG dùng cho dữ liệu mới.
  redeemed_voucher
  payout
}

// amount tính bằng ĐỒNG (VND) trực tiếp — không phải điểm quy đổi (bussiness §5.1 đã CHỐT bỏ lớp
// voucher/điểm trung gian, xem RewardLedgerType.redeemed_voucher ở trên). Dương = cộng ví (thưởng
// leaderboard/referral), âm = trừ ví (payout đã rút hoặc trừ ngược điểm khẩn cấp gian lận).
model RewardLedger {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  amount      Int
  type        RewardLedgerType
  referenceId String?          @map("reference_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reward_ledger")
}

// Số dư ví thưởng (bussiness §5.1) — denormalized từ tổng RewardLedger.amount, cùng convention cache
// như User.trustScoreE1/Post.voteCount — cập nhật ATOMIC cùng transaction với mỗi dòng ledger mới,
// tránh phải SUM toàn bộ lịch sử ledger mỗi lần đọc số dư.
model RewardWallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reward_wallets")
}

// Khoá bậc huy hiệu đầu tháng — Phương án B đã chốt (bussiness §5.1b): xếp hạng thưởng dùng bậc TẠI
// THỜI ĐIỂM ĐẦU THÁNG, cố định suốt tháng dù huy hiệu hiển thị công khai vẫn cập nhật real-time theo
// bậc thật. Ghi bởi cron chạy đầu mỗi tháng cho MỌI user đang active (kể cả không bật kiếm tiền — chỉ
// lọc theo cờ earn khi tổng hợp bảng xếp hạng, không lọc ở bước khoá bậc để đơn giản hoá cron).
model MonthlyTierSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  period           String // "YYYY-MM"
  tierAtMonthStart Int      @map("tier_at_month_start")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@map("monthly_tier_snapshots")
}

// Kết quả CHÍNH THỨC 1 kỳ (tháng) × 1 bậc — ghi bởi cron chốt bảng cuối tháng, đọc lại cho màn hình
// lịch sử thưởng. score là điểm xếp hạng cuối cùng (đã nhân trọng số + hệ số không vi phạm),
// rewardAmount null nếu bậc chưa kích hoạt trả thưởng (chưa đạt mốc 100 user, bussiness §5.1c).
model LeaderboardSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  period       String // "YYYY-MM"
  tier         Int
  userId       String   @map("user_id") @db.Uuid
  score        Float
  rank         Int
  rewardAmount Int?     @map("reward_amount")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([period, tier, userId])
  @@index([period, tier, rank])
  @@map("leaderboard_snapshots")
}

model ReferralCode {
  id              String   @id @default(uuid()) @db.Uuid
  ownerUserId     String?  @map("owner_user_id") @db.Uuid // 1 trong 2 owner field sẽ có giá trị — không ép FK vì polymorphic
  ownerMerchantId String?  @map("owner_merchant_id") @db.Uuid
  code            String   @unique
  createdAt       DateTime @default(now()) @map("created_at")

  redemptions ReferralRedemption[]

  @@map("referral_codes")
}

model ReferralRedemption {
  id             String    @id @default(uuid()) @db.Uuid
  referralCodeId String    @map("referral_code_id") @db.Uuid
  invitedUserId  String    @map("invited_user_id") @db.Uuid
  qualifiedAt    DateTime? @map("qualified_at") // chỉ thưởng sau khi có hoạt động thật trong 7 ngày đầu
  rewardGranted  Boolean   @default(false) @map("reward_granted")
  createdAt      DateTime  @default(now()) @map("created_at")

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@map("referral_redemptions")
}

// ===================== THÔNG BÁO =====================

enum PushPlatform {
  ios
  android
}

model PushToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  token     String       @unique
  platform  PushPlatform
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

enum NotifFrequency {
  daily
  weekly
  emergency_only
}

model NotificationDigestSetting {
  userId          String         @id @map("user_id") @db.Uuid
  frequency       NotifFrequency @default(weekly)
  quietHoursStart String?        @map("quiet_hours_start")
  quietHoursEnd   String?        @map("quiet_hours_end")
  // "Loại thông báo" (tai-lieu-chuc-nang.md #48) — tắt/bật riêng thông báo có bình luận mới trên
  // bài của mình, độc lập với frequency (frequency chỉ chi phối BẢN TIN gộp theo tuần/ngày). Kết
  // quả xử lý report (#49) KHÔNG có cờ riêng — luôn gửi, theo đúng thiết kế UI gốc (settings/
  // notifications.tsx không có toggle cho mục này).
  notifyComments  Boolean        @default(true) @map("notify_comments")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_digest_settings")
}

// Trung tâm thông báo trong app (tai-lieu-chuc-nang.md #47, #49) — tách khỏi PushToken (thiết bị)
// và NotificationDigestSetting (cấu hình): đây là NỘI DUNG từng thông báo đã gửi, để liệt kê lại.
model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  type        String // 'comment_on_post' | 'report_result' — string thay vì enum, dễ thêm loại mới không cần migration
  title       String
  body        String
  referenceId String?  @map("reference_id") @db.Uuid // postId/reportId liên quan, tuỳ type — FE tự điều hướng theo type
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// ===================== THỐNG KÊ & PHÁP LÝ =====================

model DailyMetricsSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  snapshotDate DateTime @map("snapshot_date") @db.Date
  areaId       String?  @map("area_id") // null = toàn hệ thống; dùng khi có nhiều khu thí điểm
  metrics      Json // G1-G8 — giữ linh hoạt vì chỉ số còn đang tinh chỉnh (bussiness §9.7)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([snapshotDate, areaId])
  @@map("daily_metrics_snapshots")
}

enum DataDeletionStatus {
  requested
  processing
  completed
  cancelled // user đăng nhập lại trong 30 ngày => khôi phục, huỷ yêu cầu (tai-lieu-chuc-nang.md #69/#73)
}

model DataDeletionRequest {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  status      DataDeletionStatus @default(requested)
  requestedAt DateTime           @default(now()) @map("requested_at")
  completedAt DateTime?          @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("data_deletion_requests")
}

// ===================== MARKETING (web tiếp thị domain chính) =====================

// Lead từ 3 form CÔNG KHAI trên web marketing (tai-lieu-chuc-nang.md #75-83): 'merchant_signup'
// (đăng ký quán ở /merchant), 'pilot_area_signup' (để lại SĐT chờ mở khu mới ở trang chủ),
// 'contact' (form Liên hệ). type dùng String thay vì enum — cùng lý do Notification.type ở trên
// (dễ thêm loại form mới không cần migration). payload giữ linh hoạt vì mỗi loại có field khác
// nhau (businessName/phoneNumber/address vs phoneNumber vs name/contact/message).
model MarketingLead {
  id        String    @id @default(uuid()) @db.Uuid
  type      String
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at")
  // null = chưa ai liên hệ lại — đánh dấu thủ công (Prisma Studio/SQL), CHƯA có UI admin riêng
  // cho việc này, ngoài phạm vi đợt build này.
  handledAt DateTime? @map("handled_at")

  @@index([type, createdAt])
  @@map("marketing_leads")
}

// Khu vực thí điểm cho admin bật/tắt + so sánh số liệu (tai-lieu-chuc-nang.md #101) — trước đây
// KHÔNG có khái niệm "khu vực chính thức" nào trong data model (chỉ có FixedArea cá nhân từng user
// và toạ độ tự do trên mỗi bài đăng). isActive THUẦN TUÝ là cờ đánh dấu nội bộ cho admin theo dõi
// tiến độ mở rộng — KHÔNG chặn/ảnh hưởng gì tới feed hay đăng bài thật của user trong khu đó (Nhóm E
// là công cụ vận hành cold-start, không phải cơ chế giới hạn truy cập).
model PilotArea {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  lat       Float
  lng       Float
  radiusKm  Float    @default(2) @map("radius_km")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pilot_areas")
}

enum LegalDocType {
  terms
  privacy
}

// Quản lý điều khoản/chính sách (tai-lieu-chuc-nang.md #103) — trước đây "phiên bản hiện hành" chỉ
// là 1 hằng số `CURRENT_TERMS_VERSION` cứng trong code (account-lifecycle.service.ts), không sửa
// được qua API. Nay là NGUỒN THẬT SỰ: AccountLifecycleService.acceptTerms/getTermsStatus đọc
// isCurrent từ bảng này thay vì hằng số — sửa ở đây ảnh hưởng THẬT tới luồng bắt buộc đồng ý điều
// khoản lúc onboarding (mục 67), không phải màn quản lý cảnh (decorative). Publish 1 bản mới =
// version mới isCurrent=true + version cũ cùng docType tự động isCurrent=false (transaction).
model LegalDocument {
  id                 String       @id @default(uuid()) @db.Uuid
  docType            LegalDocType @map("doc_type")
  version            String
  content            String
  isCurrent          Boolean      @default(false) @map("is_current")
  publishedByAdminId String?      @map("published_by_admin_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")

  publishedByAdmin AdminUser? @relation(fields: [publishedByAdminId], references: [id])

  @@unique([docType, version])
  @@index([docType, isCurrent])
  @@map("legal_documents")
}

// Mục tiêu KPI cho cộng tác viên (ngoài phạm vi tài liệu chức năng gốc — bổ sung theo yêu cầu vận
// hành). 1 bản/CTV, áp dụng LIÊN TỤC (không phải đặt lại từng tháng) — admin sửa khi cần đổi mục
// tiêu. Số liệu THẬT (bài/vote/bình luận) không lưu ở đây — đếm trực tiếp từ Post/Vote/Comment theo
// khoảng ngày admin chọn lúc xem (xem CollaboratorsService.getStats), tránh trùng lặp dữ liệu.
model CollaboratorKpiTarget {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  postsTarget    Int      @default(0) @map("posts_target")
  votesTarget    Int      @default(0) @map("votes_target")
  commentsTarget Int      @default(0) @map("comments_target")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("collaborator_kpi_targets")
}
