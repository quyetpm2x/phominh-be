# Copy sang .env và điền giá trị thật. KHÔNG BAO GIỜ commit .env vào Git.

# Prisma kết nối qua Supavisor (transaction mode) — không kết nối trực tiếp port gốc 5432
# (tai-lieu-cong-nghe-backend.md §11 / tài liệu bussiness.md §4.3 rủi ro connection pooling).
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Kết nối trực tiếp, chỉ dùng khi chạy `prisma migrate` (Prisma cần 1 kết nối không qua pgbouncer để lock migration).
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase project — "Secret key" (sb_secret_..., Dashboard → Project Settings → API Keys →
# Secret keys; bản thay thế của "Service Role Key" kiểu JWT cũ) là "chìa khóa vạn năng", chỉ đặt
# ở biến môi trường server, tuyệt đối không log ra Sentry/console (tai-lieu-cong-nghe-backend.md
# §4.2). KHÔNG còn dùng Supabase Auth cho OTP user thường nữa (NestJS tự quản lý, xem
# USER_JWT_SECRET bên dưới) — key này giờ chỉ phục vụ các thao tác Supabase khác (Storage...) nếu có.
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SECRET_KEY=""

# JWT tự phát hành cho user thường sau khi verify OTP đúng (modules/auth/token.service.ts) — KHÔNG
# dùng chung với ADMIN_JWT_SECRET (2 hệ thống token tách biệt hoàn toàn).
USER_JWT_SECRET="doi-thanh-chuoi-ngau-nhien-dai-o-production"
USER_ACCESS_TOKEN_EXPIRES_IN_SECONDS="1800"
USER_REFRESH_TOKEN_EXPIRES_IN_DAYS="60"

# JWT tự phát hành cho admin panel — xác thực riêng biệt, không dùng chung OTP với user thường
# (tài liệu bussiness.md §9.1 A1).
ADMIN_JWT_SECRET="doi-thanh-chuoi-ngau-nhien-dai-o-production"
ADMIN_JWT_EXPIRES_IN_SECONDS="28800"

# ===== OTP đăng nhập (modules/auth/otp.service.ts) =====
# Secret để HMAC-SHA256 hash OTP trước khi lưu DB — không lưu OTP dạng thô.
OTP_HASH_SECRET="doi-thanh-chuoi-ngau-nhien-dai-o-production"
OTP_MAX_PER_HOUR="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_ATTEMPTS="5"
OTP_SYSTEM_ALERT_THRESHOLD_5MIN="50"
OTP_SYSTEM_BLOCK_THRESHOLD_5MIN="300"
# SĐT test cố định (E.164 hoặc dạng thường đều được, tự chuẩn hoá) — luôn nhận OTP 000000, không
# gọi eSMS thật. Dùng cho E2E test tự động / nộp App Store-Play Store review. Phân cách bởi dấu phẩy.
TEST_PHONE_NUMBERS=""

# Cloudflare Turnstile — tắt mặc định vì chưa có site/secret key, bật khi đã đăng ký (không cần đổi code).
CAPTCHA_ENABLED="false"
CAPTCHA_SECRET_KEY=""

# console = KHÔNG gọi eSMS thật, chỉ in OTP ra log (mặc định, dùng cho dev hàng ngày, 0 chi phí).
# sandbox = gọi eSMS thật với cờ Sandbox=1, không tính phí, dùng để test tích hợp API.
# real = gửi SMS thật, tốn phí — BẮT BUỘC ở production (app.module.ts chặn khởi động nếu không phải "real").
SMS_OTP_MODE="console"
SMS_OTP_API_KEY=""
SMS_OTP_SECRET_KEY=""
SMS_OTP_BRANDNAME=""

# Tích hợp ngoài — để trống ở giai đoạn scaffold, điền khi nối thật.
VISION_API_KEY=""
MAPBOX_ACCESS_TOKEN=""
# Mã hoá số tài khoản ngân hàng (user_bank_accounts) — đổi sang KMS thật khi lên production
# (src/common/utils/bank-account-crypto.ts).
BANK_ACCOUNT_ENCRYPTION_KEY="doi-thanh-chuoi-bi-mat-dai-o-production"

VNPAY_MERCHANT_ID=""
VNPAY_SECRET_KEY=""
MOMO_PARTNER_CODE=""
MOMO_SECRET_KEY=""

SENTRY_DSN=""

PORT=3000
NODE_ENV="development"
